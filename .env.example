# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPENFDA_API_KEY: Optional openFDA API key for higher rate limits (https://open.fda.gov/apis/authentication/).
OPENFDA_API_KEY=""

# DATABASE_URL: Optional PostgreSQL connection string or SQLite file path (defaults to ./data/pharmaintel.sqlite).
DATABASE_URL="./data/pharmaintel.sqlite"

# CRM_PROVIDER: Optional CRM integration ('none' | 'salesforce' | 'hubspot'). Disabled by default until configured.
CRM_PROVIDER="none"
CRM_API_ENDPOINT=""
CRM_CLIENT_ID=""
CRM_CLIENT_SECRET=""
CRM_SANDBOX_MODE="true"

# EMAIL_PROVIDER: Optional Email Outreach provider ('none' | 'sendgrid' | 'ses' | 'smtp'). Disabled by default.
EMAIL_PROVIDER="none"
EMAIL_API_KEY=""
EMAIL_FROM_ADDRESS=""

# ADMIN_ACCESS_TOKEN: Optional server-side token for protected administrative mutations.
ADMIN_ACCESS_TOKEN=""

